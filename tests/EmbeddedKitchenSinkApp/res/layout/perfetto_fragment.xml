<!-- Main container for the Perfetto test fragment -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ScrollView to ensure content is accessible on smaller screens -->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title of the fragment -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perfetto_control_panel_title"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Button to push a default Perfetto configuration -->
                    <Button
                        android:id="@+id/btn_push_default_config"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/perfetto_push_default_config" />

                    <!-- Button to query the current Perfetto configuration -->
                    <Button
                        android:id="@+id/btn_query_config"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/perfetto_query_config" />

                    <!-- Button to remove the Perfetto configuration -->
                    <Button
                        android:id="@+id/btn_remove_config"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/perfetto_remove_config" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Button to trigger a Perfetto trace -->
                    <Button
                        android:id="@+id/btn_trigger_perfetto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/perfetto_trigger_trace" />

                    <!-- Button to open the Perfetto trace list -->
                    <Button
                        android:id="@+id/btn_open_trace_list"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/perfetto_open_trace_list" />
                </LinearLayout>
            </LinearLayout>

            <!-- TextView to display the status of Perfetto operations -->
            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#292520"
                android:padding="8dp"
                android:text="@string/perfetto_status_idle"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

    <!-- ImageView styled to look like a Floating Action Button to scroll to the top -->
    <ImageView
        android:id="@+id/fab_scroll_to_top"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:src="@drawable/ic_scroll_to_top"
        android:background="@drawable/fab_background"
        android:tint="@color/car_teal_700"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="6dp"
        android:scaleType="center" />

</RelativeLayout>
