# proto-file: external/perfetto/protos/perfetto/config/trace_config.proto
# proto-message: TraceConfig

# This config is intended to be used on android version 14 and above.

# Note: This config only contains data sources that support multiple concurrent tracing sessions.
# This ensures that the perfetto tracing session started with this config won't lead to the current
# session or another concurrent session missing data from data sources that don't support
# multiple concurrent tracing sessions. For more information on this, please refer to
# https://perfetto.dev/docs/concepts/concurrent-tracing-sessions.

buffers {
  size_kb: 512
  fill_policy: RING_BUFFER
}
buffers {
  size_kb: 4096
  fill_policy: RING_BUFFER
}
buffers {
  size_kb: 128
  fill_policy: RING_BUFFER
}
buffers {
  size_kb: 28608
  fill_policy: RING_BUFFER
}
buffers {
  size_kb: 128
  fill_policy: RING_BUFFER
}
buffers {
  size_kb: 2048
  fill_policy: RING_BUFFER
}
buffers {
  size_kb: 1024
  fill_policy: RING_BUFFER
}
buffers {
  size_kb: 409600
  fill_policy: RING_BUFFER
  transfer_on_clone: true
  clear_before_clone: true
}
buffers {
  size_kb: 2048
  fill_policy: RING_BUFFER
}
data_sources {
  config {
    name: "android.packages_list"
    target_buffer: 0
  }
}
data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config {
      scan_all_processes_on_start: true
    }
  }
}
data_sources {
  config {
    name: "linux.sys_stats"
    target_buffer: 2
    sys_stats_config {
      meminfo_period_ms: 1000
      meminfo_counters: MEMINFO_ACTIVE_ANON
      meminfo_counters: MEMINFO_ACTIVE_FILE
      meminfo_counters: MEMINFO_INACTIVE_ANON
      meminfo_counters: MEMINFO_INACTIVE_FILE
      meminfo_counters: MEMINFO_KERNEL_STACK
      meminfo_counters: MEMINFO_MLOCKED
      meminfo_counters: MEMINFO_SHMEM
      meminfo_counters: MEMINFO_SLAB
      meminfo_counters: MEMINFO_SLAB_UNRECLAIMABLE
      meminfo_counters: MEMINFO_VMALLOC_USED
      meminfo_counters: MEMINFO_MEM_FREE
      meminfo_counters: MEMINFO_SWAP_FREE
      vmstat_period_ms: 1000
      vmstat_counters: VMSTAT_PGFAULT
      vmstat_counters: VMSTAT_PGMAJFAULT
      vmstat_counters: VMSTAT_PGFREE
      vmstat_counters: VMSTAT_PGPGIN
      vmstat_counters: VMSTAT_PGPGOUT
      vmstat_counters: VMSTAT_PSWPIN
      vmstat_counters: VMSTAT_PSWPOUT
      vmstat_counters: VMSTAT_PGSCAN_DIRECT
      vmstat_counters: VMSTAT_PGSTEAL_DIRECT
      vmstat_counters: VMSTAT_PGSCAN_KSWAPD
      vmstat_counters: VMSTAT_PGSTEAL_KSWAPD
      vmstat_counters: VMSTAT_WORKINGSET_REFAULT
    }
  }
}
data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 2
    process_stats_config {
      quirks: DISABLE_ON_DEMAND
      proc_stats_poll_ms: 30000
    }
  }
}
data_sources {
  config {
    name: "android.surfaceflinger.frametimeline"
    target_buffer: 3
  }
}
data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 3
    ftrace_config {
      ftrace_events: "ftrace/print"
      ftrace_events: "lowmemorykiller/lowmemory_kill"
      ftrace_events: "oom/oom_score_adj_update"
      ftrace_events: "oom/mark_victim"
      ftrace_events: "gpu_mem/gpu_mem_total"
      ftrace_events: "dmabuf_heap/dma_heap_stat"
      ftrace_events: "ion/ion_stat"
      ftrace_events: "kmem/ion_heap_grow"
      ftrace_events: "kmem/ion_heap_shrink"
      ftrace_events: "rss_stat"
      ftrace_events: "fastrpc/fastrpc_dma_stat"
      ftrace_events: "power/suspend_resume"
      ftrace_events: "sched/sched_blocked_reason"
      ftrace_events: "sched/sched_process_free"
      ftrace_events: "sched/sched_switch"
      ftrace_events: "task/task_newtask"
      ftrace_events: "task/task_rename"
      ftrace_events: "power/wakeup_source_activate"
      ftrace_events: "power/wakeup_source_deactivate"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "sched/sched_wakeup_new"
      ftrace_events: "workqueue/workqueue_activate_work"
      ftrace_events: "workqueue/workqueue_execute_end"
      ftrace_events: "workqueue/workqueue_execute_start"
      ftrace_events: "workqueue/workqueue_queue_work"
      ftrace_events: "vmscan/mm_vmscan_kswapd_wake"
      ftrace_events: "vmscan/mm_vmscan_kswapd_sleep"
      ftrace_events: "vmscan/mm_vmscan_direct_reclaim_begin"
      ftrace_events: "vmscan/mm_vmscan_direct_reclaim_end"
      ftrace_events: "compaction/mm_compaction_begin"
      ftrace_events: "compaction/mm_compaction_end"
      ftrace_events: "cma/cma_alloc_start"
      ftrace_events: "cma/cma_alloc_info"
      ftrace_events: "f2fs/f2fs_iostat"
      ftrace_events: "f2fs/f2fs_iostat_latency"
      ftrace_events: "f2fs/f2fs_background_gc"
      ftrace_events: "f2fs/f2fs_gc_begin"
      ftrace_events: "f2fs/f2fs_gc_end"
      ftrace_events: "f2fs/f2fs_sync_fs"
      ftrace_events: "binder/binder_command"
      ftrace_events: "binder/binder_return"
      atrace_categories: "am"
      atrace_categories: "camera"
      atrace_categories: "ss"
      atrace_categories: "dalvik"
      atrace_categories: "bionic"
      atrace_categories: "aidl"
      atrace_categories: "audio"
      atrace_categories: "binder_driver"
      atrace_categories: "disk"
      atrace_categories: "freq"
      atrace_categories: "gfx"
      atrace_categories: "hal"
      atrace_categories: "input"
      atrace_categories: "res"
      atrace_categories: "sched"
      atrace_categories: "view"
      atrace_categories: "wm"
      atrace_categories: "thermal"
      atrace_apps: "lmkd"
      atrace_apps: "android.car.cluster"
      atrace_apps: "android.car.usb.handler"
      atrace_apps: "android.process.acore"
      atrace_apps: "android:ui"
      atrace_apps: "com.android.systemui"
      atrace_apps: "com.android.camera2"
      atrace_apps: "lmkd"
      atrace_apps: "system_server"
      atrace_apps: "com.android.car.carlauncher"
      atrace_apps: "com.android.car.cartelemetryapp"
      atrace_apps: "com.android.car.castreceiver"
      atrace_apps: "com.android.car.dialer"
      atrace_apps: "com.android.car.media"
      atrace_apps: "com.android.car.messenger"
      atrace_apps: "com.android.car.radio"
      atrace_apps: "com.android.car.rotary"
      atrace_apps: "com.android.car.settings"
      atrace_apps: "com.android.chrome"
      atrace_apps: "com.android.companiondevicemanager"
      atrace_apps: "com.android.managedprovisioning"
      atrace_apps: "com.android.networkstack.process"
      atrace_apps: "com.android.vending"
      atrace_apps: "com.google.android.apps.automotive.youtube"
      atrace_apps: "com.google.android.apps.automotive.inputmethod"
      atrace_apps: "com.google.android.apps.automotive.sensing.sensorreplay.recordingapp"
      atrace_apps: "com.google.android.apps.automotive.templates.host"
      atrace_apps: "com.google.android.apps.books"
      atrace_apps: "com.google.android.apps.geo.autograph.vms.client.console.car"
      atrace_apps: "com.google.android.apps.geo.autograph.vms.client.playback"
      atrace_apps: "com.google.android.apps.geo.automotive.adas"
      atrace_apps: "com.google.android.apps.geo.vms.analyzer"
      atrace_apps: "com.google.android.apps.maps"
      atrace_apps: "com.google.android.apps.mediashell"
      atrace_apps: "com.google.android.apps.youtube.music"
      atrace_apps: "com.google.android.bluetooth"
      atrace_apps: "com.google.android.car.adaslocation"
      atrace_apps: "com.google.android.car.defaultstoragemonitoringcompanionapp"
      atrace_apps: "com.google.android.car.evs"
      atrace_apps: "com.google.android.car.netdbug"
      atrace_apps: "com.google.android.car.networking"
      atrace_apps: "com.google.android.car.setupwizard"
      atrace_apps: "com.google.android.carassistant"
      atrace_apps: "com.google.android.cellbroadcastservice"
      atrace_apps: "com.google.android.companiondevicesupport"
      atrace_apps: "com.google.android.embedded.projection"
      atrace_apps: "com.google.android.gms"
      atrace_apps: "com.google.android.gms.persistent"
      atrace_apps: "com.google.android.gsf"
      atrace_apps: "com.google.android.packageinstaller"
      atrace_apps: "com.google.android.permissioncontroller"
      atrace_apps: "com.google.android.providers.media.module"
      atrace_apps: "com.google.android.software.cast_receiver"
      atrace_apps: "com.google.android.tts"
      atrace_apps: "com.google.android.webview"
      atrace_apps: "com.waze"
      buffer_size_kb: 4096
      compact_sched {
        enabled: true
      }
      symbolize_ksyms: true
      throttle_rss_stat: true
      disable_generic_events: true
      ksyms_mem_policy: KSYMS_RETAIN
    }
  }
}
data_sources {
  config {
    name: "android.network_packets"
    target_buffer: 4
    network_packet_trace_config {
      poll_ms: 500
      aggregation_threshold: 5
      intern_limit: 1000
      drop_local_port: true
      drop_tcp_flags: true
    }
  }
}
data_sources {
  config {
    name: "com.android.wm.shell.transition"
    target_buffer: 5
  }
}
data_sources {
  config {
    name: "android.protolog"
    target_buffer: 5
    protolog_config {
      group_overrides {
        group_name: "WM_ERROR"
        log_from: PROTOLOG_LEVEL_WARN
      }
      group_overrides {
        group_name: "WM_DEBUG_WALLPAPER"
        log_from: PROTOLOG_LEVEL_DEBUG
      }
      group_overrides {
        group_name: "WM_DEBUG_DIMMER"
        log_from: PROTOLOG_LEVEL_DEBUG
      }
      group_overrides {
        group_name: "WM_DEBUG_FOCUS_LIGHT"
        log_from: PROTOLOG_LEVEL_DEBUG
      }
      group_overrides {
        group_name: "WM_DEBUG_APP_TRANSITIONS"
        log_from: PROTOLOG_LEVEL_DEBUG
      }
      group_overrides {
        group_name: "WM_DEBUG_ANIM"
        log_from: PROTOLOG_LEVEL_INFO
      }
      group_overrides {
        group_name: "WM_DEBUG_RECENTS_ANIMATIONS"
        log_from: PROTOLOG_LEVEL_DEBUG
      }
      group_overrides {
        group_name: "WM_DEBUG_WINDOW_TRANSITIONS"
        log_from: PROTOLOG_LEVEL_DEBUG
      }
      group_overrides {
        group_name: "WM_DEBUG_WINDOW_TRANSITIONS_MIN"
        log_from: PROTOLOG_LEVEL_DEBUG
      }
      group_overrides {
        group_name: "WM_SHELL_TRANSITIONS"
        log_from: PROTOLOG_LEVEL_DEBUG
      }
      group_overrides {
        group_name: "WM_SHELL_RECENTS_TRANSITION"
        log_from: PROTOLOG_LEVEL_DEBUG
      }
    }
  }
}
data_sources {
  config {
    name: "android.surfaceflinger.transactions"
    target_buffer: 6
    surfaceflinger_transactions_config {
      mode: MODE_CONTINUOUS
    }
  }
}
data_sources {
  config {
    name: "android.surfaceflinger.layers"
    target_buffer: 7
    surfaceflinger_layers_config {
      mode: MODE_GENERATED_BUGREPORT_ONLY
      trace_flags: TRACE_FLAG_INPUT
      trace_flags: TRACE_FLAG_BUFFERS
    }
  }
}
data_sources {
  config {
    name: "android.input.inputevent"
    target_buffer: 8
    android_input_event_config {
      mode: TRACE_MODE_USE_RULES
      rules {
        trace_level: TRACE_LEVEL_NONE
        match_secure: true
      }
      rules {
        trace_level: TRACE_LEVEL_COMPLETE
        match_all_packages: "com.android.shell"
        match_all_packages: "com.android.systemui"
        match_all_packages: "com.android.car.carlauncher"
        match_ime_connection_active: false
      }
      rules {
        trace_level: TRACE_LEVEL_REDACTED
      }
      trace_dispatcher_input_events: true
      trace_dispatcher_window_dispatch: true
    }
  }
}
