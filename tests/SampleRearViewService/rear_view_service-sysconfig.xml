<!--
    This file is a system configuration for the SampleRearViewService.
    It allows the service to run in power save mode, which is important for a
    persistent service that needs to be available even when the device is in a
    low-power state. Furthermore, this service is included in the camera privacy allowlist,
    ensuring it retains camera access at all times, independent of the
    camera privacy toggle setting.
-->
<config>
    <allow-in-power-save package="com.google.android.car.samplerearviewservice" />
    <camera-privacy-allowlisted-app package="com.google.android.car.samplerearviewservice" />
</config>
