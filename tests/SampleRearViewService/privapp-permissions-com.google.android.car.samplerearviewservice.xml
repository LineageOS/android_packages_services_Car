<!--
    This file grants privileged permissions to the SampleRearViewService.
    These are permissions that can only be granted to system applications.
-->
<permissions>
    <privapp-permissions package="com.google.android.car.samplerearviewservice">
        <!-- Allows the service to access the camera declared as system camera. -->
        <permission name="android.permission.SYSTEM_CAMERA" />
        <!-- Allows the service to access the camera by the system user. -->
        <permission name="android.permission.CAMERA_HEADLESS_SYSTEM_USER" />
        <!-- Allows the service to be on the camera privacy allowlist. -->
        <permission name="android.permission.CAMERA_PRIVACY_ALLOWLIST" />
        <!-- Include INTERACT_ACROSS_USERS only if you need to support multi-user functionality -->
        <!-- Allows the service to interact with users across user boundaries. -->
        <permission name="android.permission.INTERACT_ACROSS_USERS" />
        <!-- Allows the service to start activities from the background. -->
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    </privapp-permissions>
</permissions>
