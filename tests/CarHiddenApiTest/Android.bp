package {
    default_team: "trendy_team_aaos_framework",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_test {
    name: "CarHiddenApiTest",

    srcs: [
        "src/**/*.java",
    ],

    // for system|privileged permission.
    certificate: "platform",

    min_sdk_version: "33",
    target_sdk_version: "34",

    optimize: {
        enabled: false,
    },

    static_libs: [
        "junit",
        "android.car.testapi.testbase",
        "bedstead-enterprise",
    ],

    libs: [
        "android.car",
    ],

    // mockito-target-inline dependency
    jni_libs: [
        "libdexmakerjvmtiagent",
        "libstaticjvmtiagent",
        "libcarservicejni",
    ],

    test_suites: [
        "device-tests",
        "automotive-tests",
    ],
}
