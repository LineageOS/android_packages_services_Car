package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

soong_config_module_type {
  name: "cam_config_cc_defaults",
  module_type: "cc_defaults",
  config_namespace: "evscam",
  bool_variables: ["use_ar0231"],
  properties: ["cflags"],
}

cam_config_cc_defaults {
    name: "cam_config_defaults",
    soong_config_variables: {
        use_ar0231: {
            cflags: ["-DUSE_AR0231"],
        },
    },
}

cc_binary {
    name: "evs_app",
    defaults: [
        "aconfig_lib_cc_shared_link.defaults",
        "android.hardware.graphics.common-ndk_shared",
        "vhalclient_defaults",
        "cam_config_defaults",
    ],
    local_include_dirs: ["inc"],
    include_dirs: [
        "packages/services/Car/cpp/evs/manager/compat/include",
    ],
    srcs: ["src/*.cpp"],
    shared_libs: [
        "android.hardware.automotive.vehicle@2.0",
        "android.hardware.camera.device@3.2",
        "libEGL",
        "libGLESv2",
        "libbase",
        "libbinder",
        "libbinder_ndk",
        "libcamera2ndk",
        "libcamera_metadata",
        "libcartelemetry-evs-proto",
        "libcutils",
        "libhardware",
        "libmediandk",
        "libnativewindow",
        "libpng",
        "libprotobuf-cpp-lite",
        "libui",
        "libutils",
    ],
    static_libs: [
        "android.car.feature-aconfig-cpp",
        "android.frameworks.automotive.telemetry-V1-ndk",
        "android.hardware.automotive.evs-V2-ndk",
        "android.hardware.common-V2-ndk",
        "libaidlcommonsupport",
        "libevs_compat",
        "libmath",
        "libjsoncpp",
        "libvhalclient",
    ],
    required: [
        "config.json",
        "CarFromTop.png",
        "LabeledChecker.png",
    ],
    init_rc: ["evs_app.rc"],
    cflags: [
        "-DLOG_TAG=\"EvsApp\"",
        "-DGL_GLEXT_PROTOTYPES",
        "-DEGL_EGLEXT_PROTOTYPES",
        "-Wall",
        "-Werror",
        "-Wunused",
        "-Wunreachable-code",
    ],
}

cc_library {
    name: "libcartelemetry-evs-proto",
    srcs: [":cartelemetry-evs-proto-srcs"],
    proto: {
        export_proto_headers: true,
        type: "lite",
    },
    shared_libs: ["libprotobuf-cpp-lite"],
}

prebuilt_etc {
    name: "config.json",
    src: "res/config.json",
    sub_dir: "automotive/evs",
}

prebuilt_etc {
    name: "CarFromTop.png",
    src: "res/CarFromTop.png",
    sub_dir: "automotive/evs",
}

prebuilt_etc {
    name: "LabeledChecker.png",
    src: "res/LabeledChecker.png",
    sub_dir: "automotive/evs",
}
