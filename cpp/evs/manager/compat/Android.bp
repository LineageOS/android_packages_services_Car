package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_aaos_vac_triage",
}

filegroup {
    name: "evs_compat_sources",
    srcs: [
        "src/*.cpp",
    ],
}

cc_library_static {
    name: "libevs_compat",
    defaults: [
        "aconfig_lib_cc_shared_link.defaults",
        "android.hardware.graphics.common-ndk_static",
    ],
    cflags: [
        "-Werror",
        "-Wno-unused-parameter",
    ],
    include_dirs: [
        "packages/services/Car/cpp/evs/manager/compat/include",
    ],
    srcs: [
        ":evs_compat_sources",
    ],
    static_libs: [
        "android.car.feature-aconfig-cpp",
        "android.hardware.automotive.evs-V2-ndk",
        "android.hardware.common-V2-ndk",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcamera2ndk",
        "libcamera_metadata",
        "liblog",
    ],
}

cc_test {
    name: "evs_compat_test",
    defaults: [
        "aconfig_lib_cc_shared_link.defaults",
        "android.hardware.graphics.common-ndk_static",
    ],
    cflags: [
        "-Werror",
        "-Wno-unused-parameter",
        "-DEVS_COMPAT_TEST",
    ],
    include_dirs: [
        "packages/services/Car/cpp/evs/manager/compat/include",
        "packages/services/Car/cpp/evs/manager/compat/test",
    ],
    srcs: [
        ":evs_compat_sources",
        "test/Converter_test.cpp",
        "test/CompatEnumerator_test.cpp",
        "test/CompatEnumeratorIntegrationTest.cpp",
    ],
    static_libs: [
        "android.car.feature-aconfig-cpp",
        "android.hardware.automotive.evs-V2-ndk",
        "android.hardware.common-V2-ndk",
        "libevs_compat",
        "libgtest_main",
        "libgmock",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcamera2ndk",
        "libcamera_metadata",
        "liblog",
    ],

}