package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_aaos_vac_triage",
}

filegroup {
    name: "evs_compat_sources",
    srcs: [
        "src/*.cpp",
    ],
}

cc_library_static {
    name: "libevs_compat",
    defaults: [
        "android.hardware.graphics.common-ndk_static",
    ],
    cflags: [
        "-Werror",
        "-Wno-unused-parameter",
    ],
    include_dirs: [
        "packages/services/Car/cpp/evs/manager/compat/include",
    ],
    srcs: [
        ":evs_compat_sources",
    ],
    static_libs: [
        "android.hardware.automotive.evs-V2-ndk",
        "android.hardware.common-V2-ndk",
        "libaidlcommonsupport",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcamera2ndk",
        "libcamera_metadata",
        "liblog",
        "libmediandk",
    ],
}

cc_defaults {
    name: "evs_compat_test_defaults",
    defaults: [
        "android.hardware.graphics.common-ndk_static",
    ],
    cflags: [
        "-Werror",
        "-Wno-unused-parameter",
        "-DEVS_COMPAT_TEST",
    ],
    include_dirs: [
        "packages/services/Car/cpp/evs/manager/compat/include",
        "packages/services/Car/cpp/evs/manager/compat/test",
    ],
    static_libs: [
        "android.hardware.automotive.evs-V2-ndk",
        "android.hardware.common-V2-ndk",
        "libaidlcommonsupport",
        "libgtest_main",
    ],
    shared_libs: [
        "libandroid",
        "libbase",
        "libbinder_ndk",
        "libcamera2ndk",
        "libcamera_metadata",
        "libcutils",
        "liblog",
        "libmediandk",
    ],
}

cc_test {
    name: "evs_compat_unit_tests",
    defaults: ["evs_compat_test_defaults"],
    srcs: [
        ":evs_compat_sources",
        "test/Converter_test.cpp",
        "test/CompatEnumerator_test.cpp",
        "test/CompatHalCamera_test.cpp",
        "test/CompatVirtualCamera_test.cpp",
        "test/MockNdkCamera.cpp",
    ],
    static_libs: [
        "libgmock",
    ],
}

cc_test {
    name: "evs_compat_integration_tests",
    defaults: ["evs_compat_test_defaults"],
    srcs: [
        "test/CompatEnumeratorIntegrationTest.cpp",
    ],
    static_libs: [
        "libevs_compat",
    ],
}
