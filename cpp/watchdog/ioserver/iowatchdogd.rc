service iowatchdogd /system/bin/iowatchdogd
    class core
    user system
    group system readproc
    capabilities SYS_NICE
    disabled

on early-init
    # Below intervals are in seconds
    setprop ro.iowatchdog.periodic_collection_interval 120
    setprop ro.iowatchdog.periodic_monitor_interval 5

on post-fs-data
    mkdir /data/system/io-watchdog 0700 system system

on property:sys.boot_completed=1

    # Cache size for the periodically monitored records
    setprop ro.iowatchdog.periodic_monitor_buffer_size 360

    # Start the service only after initializing the properties.
    start iowatchdogd
