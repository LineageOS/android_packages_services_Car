#####################################
# iowatchdog_client_domain(domain)
# Allow a base set of permissions required for a domain to be a
# client of a iowatchdog.
#
# For example, make some_domain a io watchd client:
#   iowatchdog_client_domain(some_domain)
#
define(`iowatchdog_client_domain', `
typeattribute $1 iowatchdogclient_domain;
')
