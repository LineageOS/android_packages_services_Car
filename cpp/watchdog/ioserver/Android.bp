package {
    default_team: "trendy_team_aaos_framework",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

vintf_fragment {
    name: "iowatchdogd.xml",
    src: "iowatchdogd.xml",
}

cc_binary {
    name: "iowatchdogd",
    defaults: [
        "watchdogdbase_defaults",
        "libwatchdogbase_service_manager_defaults",
    ],
    srcs: [
        "src/main.cpp",
    ],
    init_rc: ["iowatchdogd.rc"],
    static_libs: [
        "libwatchdogbase_service_manager",
    ],
    vintf_fragment_modules: ["iowatchdogd.xml"],
    required: [
        "system_resource_overuse_configuration.xml",
        "third_party_resource_overuse_configuration.xml",
    ],
}
