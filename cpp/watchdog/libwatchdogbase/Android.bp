package {
    default_team: "trendy_team_aaos_framework",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "watchdogdbase_defaults",
    cflags: [
        "-Wall",
        "-Wno-missing-field-initializers",
        "-Werror",
        "-Wno-unused-variable",
        "-Wunused-parameter",
        "-Wno-error=deprecated",
        "-DANDROID_UTILS_REF_BASE_DISABLE_IMPLICIT_CONSTRUCTION",
    ],
    include_dirs: [
        "system/libbase/include",
    ],
    shared_libs: [
        "libbase",
        "libbinder",
        "libbinder_ndk",
        "liblog",
        "libutils",
        "packagemanager_aidl-cpp",
        "libprotoutil",
        "libcutils",
    ],
    static_libs: [
        "android.automotive.watchdog.internal-ndk",
        "android.automotive.watchdog-V3-ndk",
        "libwatchdog_properties",
    ],
    header_libs: [
        "libgtest_prod_headers",
    ],
}

cc_library {
    name: "libwatchdogbase_looper_wrapper",
    srcs: [
        "src/LooperWrapper.cpp",
    ],
    defaults: [
        "watchdogdbase_defaults",
    ],
    export_include_dirs: [
        "src",
    ],
}

cc_library {
    name: "libwatchdogbase_package_info_resolver",
    srcs: [
        "src/PackageInfoResolver.cpp",
    ],
    defaults: [
        "watchdogdbase_defaults",
    ],
    whole_static_libs: [
        "libwatchdogbase_looper_wrapper",
    ],
    shared_libs: [
        "libprocessgroup",
    ],
    export_include_dirs: [
        "src",
    ],
}

cc_defaults {
    name: "libwatchdogbase_io_overuse_monitor_defaults",
    shared_libs: [
        "libprocessgroup",
        "libtinyxml2",
    ],
}

cc_library {
    name: "libwatchdogbase_binder_utils",
    srcs: [
        "src/AIBinderDeathRegistrationWrapper.cpp",
    ],
    defaults: [
        "watchdogdbase_defaults",
    ],
    export_include_dirs: [
        "src",
    ],
}

cc_library {
    name: "libwatchdogbase_uid_stats",
    srcs: [
        "src/UidIoStatsCollector.cpp",
        "src/UidStatsCollectorBase.cpp",
    ],
    defaults: [
        "watchdogdbase_defaults",
    ],
    static_libs: [
        "libwatchdogbase_package_info_resolver",
    ],
    export_include_dirs: [
        "src",
    ],
}

cc_library {
    name: "libwatchdogbase_service_helper",
    srcs: [
        "src/WatchdogServiceHelperBase.cpp",
    ],
    defaults: [
        "watchdogdbase_defaults",
    ],
    static_libs: [
        "libwatchdogbase_binder_utils",
    ],
    export_include_dirs: [
        "src",
    ],
}

cc_library {
    name: "libwatchdogbase_io_overuse_monitor",
    defaults: [
        "watchdogdbase_defaults",
        "libwatchdogbase_io_overuse_monitor_defaults",
    ],
    srcs: [
        "src/IoOveruseConfigs.cpp",
        "src/IoOveruseMonitor.cpp",
        "src/OveruseConfigurationXmlHelper.cpp",
        "src/ProcDiskStatsCollector.cpp",
        "src/WatchdogPerfServiceBase.cpp",
    ],
    static_libs: [
        "libwatchdogbase_binder_utils",
        "libwatchdogbase_package_info_resolver",
        "libwatchdogbase_uid_stats",
    ],
    export_include_dirs: [
        "src",
    ],
}

cc_library {
    name: "libwatchdogbase_test_utils",
    defaults: [
        "watchdogdbase_defaults",
        "libwatchdogbase_service_manager_defaults",
    ],
    srcs: [
        "tests/LooperStub.cpp",
        "tests/PackageInfoTestUtils.cpp",
        "tests/UidStatsCollectorBaseTestUtils.cpp",
    ],
    static_libs: [
        "libgmock",
        "libgtest",
    ],
    export_include_dirs: [
        "tests",
    ],
}

cc_library_headers {
    name: "libwatchdogbase_test_headers",
    defaults: [
        "watchdogdbase_defaults",
    ],
    static_libs: [
        "libgmock",
    ],
    export_include_dirs: [
        "tests",
    ],
}

filegroup {
    name: "watchdogbase_test_xml_files",
    srcs: [
        "tests/data/*.xml",
    ],
}

cc_test {
    name: "libwatchdogbase_test",
    team: "trendy_team_aaos_performance_triage",
    defaults: [
        "watchdogdbase_defaults",
        "libwatchdogbase_service_manager_defaults",
    ],
    tidy_disabled_srcs: [
        // b/207508335
        "tests/PackageInfoResolverTest.cpp",
    ],
    tidy_timeout_srcs: [
        "tests/IoOveruseMonitorTest.cpp",
    ],
    test_suites: [
        "general-tests",
        "automotive-general-tests",
    ],
    srcs: [
        "tests/IoOveruseConfigsTest.cpp",
        "tests/IoOveruseMonitorTest.cpp",
        "tests/OveruseConfigurationTestUtils.cpp",
        "tests/OveruseConfigurationXmlHelperTest.cpp",
        "tests/PackageInfoResolverTest.cpp",
        "tests/ProcDiskStatsCollectorTest.cpp",
        "tests/UidIoStatsCollectorTest.cpp",
        "tests/UidStatsCollectorBaseTest.cpp",
        "tests/WatchdogPerfServiceBaseTest.cpp",
        "tests/WatchdogServiceHelperBaseTest.cpp",
    ],
    data: [":watchdogbase_test_xml_files"],
    static_libs: [
        "libgmock",
        "libgtest",
        "libwatchdogbase_looper_wrapper",
        "libwatchdogbase_test_utils",
    ],
}

cc_defaults {
    name: "libwatchdogbase_service_manager_defaults",
    defaults: [
        "watchdogdbase_defaults",
        "libwatchdogbase_io_overuse_monitor_defaults",
    ],
    static_libs: [
        "libwatchdogbase_binder_utils",
        "libwatchdogbase_io_overuse_monitor",
        "libwatchdogbase_package_info_resolver",
        "libwatchdogbase_service_helper",
        "libwatchdogbase_uid_stats",
    ],
}

cc_library {
    name: "libwatchdogbase_service_manager",
    defaults: [
        "libwatchdogbase_service_manager_defaults",
    ],
    srcs: [
        "src/IoServiceManager.cpp",
    ],
    export_include_dirs: [
        "src",
    ],
}

prebuilt_etc {
    name: "pilot_system_resource_overuse_configuration.xml",
    src: "data/system_resource_overuse_configuration.xml",
    sub_dir: "automotive/watchdog/",
}

prebuilt_etc {
    name: "pilot_third_party_resource_overuse_configuration.xml",
    src: "data/third_party_resource_overuse_configuration.xml",
    sub_dir: "automotive/watchdog/",
}
