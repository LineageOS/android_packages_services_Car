package {
    default_team: "trendy_team_aaos_carframework_triage",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library {
    name: "liblargeparcelablejni",
    srcs: [
        "src/*.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder",
        "libbinder_ndk",
        "liblog",
        "libnativehelper",
    ],
    header_libs: ["jni_headers"],
    strip: {
        keep_symbols: true,
    },
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wthread-safety",
    ],
    host_supported: true,
}

cc_test {
    name: "LargeParcelableParcelUtilsTest",
    srcs: [
        "test/*.cpp",
    ],
    local_include_dirs: [
        "src",
    ],
    static_libs: [
        "liblargeparcelablejni",
    ],
    shared_libs: [
        "libbinder",
        "libbinder_ndk",
    ],
    test_suites: ["device-tests"],
    host_supported: true,
}
