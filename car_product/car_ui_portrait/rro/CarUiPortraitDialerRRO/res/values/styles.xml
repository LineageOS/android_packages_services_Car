<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Phone -->

    <!-- Call history -->
    <style name="TextAppearance.CallLogSubtitle">
        <item name="android:textAppearance">?attr/oemTextAppearanceBodySmall</item>
        <item name="android:textColor">?attr/oemColorOnSurfaceVariant</item>
    </style>

    <!-- Customized text color for missed calls can be added here -->

    <style name="TextAppearance.CallLogCallCountMissedCall">
        <item name="android:textAppearance">?attr/oemTextAppearanceBodySmall</item>
        <item name="android:textColor">?attr/oemColorError</item>
    </style>

    <style name="DialpadCallButton">
        <item name="android:background">@drawable/dialer_call_button_background</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/dialer_keypad_button_height</item>
        <item name="android:layout_margin">@dimen/dialer_keypad_button_margin</item>
        <item name="android:minWidth">@dimen/dialer_call_button_min_width</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">?attr/oemColorOnPrimary</item>
    </style>

    <style name="DialpadSecondaryButton">
        <item name="android:background">@drawable/dialer_ripple_background</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">?attr/oemColorOnSecondaryContainer</item>
        <item name="android:layout_width">@dimen/dialer_keypad_button_width</item>
        <item name="android:layout_height">@dimen/dialer_keypad_button_height</item>
        <item name="android:layout_margin">@dimen/dialer_keypad_button_margin</item>
    </style>

    <style name="TextAppearance.DialpadDisplayName" parent="TextAppearance.Body1"/>

    <style name="TextAppearance.ContactDetailsTitle">
        <item name="android:textAppearance">?attr/oemTextAppearanceBodyMedium</item>
    </style>

    </resources>
