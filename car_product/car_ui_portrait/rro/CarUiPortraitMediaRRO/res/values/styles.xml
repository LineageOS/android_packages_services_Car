<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="MediaIconContainerStyle">
        <item name="android:background">@drawable/image_background</item>
        <item name="android:clipToOutline">true</item>
    </style>
    <style name="MediaGridIconContainerStyle">
        <item name="android:background">@drawable/grid_image_background</item>
        <item name="android:clipToOutline">true</item>
    </style>
    <style name="BrowseGridTitleStyle">
        <item name="android:textAppearance">?attr/oemTextAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/oemColorOnSurface</item>
    </style>
    <style name="BrowseGridSubtitleStyle">
        <item name="android:textAppearance">?attr/oemTextAppearanceBodySmall</item>
        <item name="android:textColor">?attr/oemColorOnSurfaceVariant</item>
    </style>
    <style name="BrowseListTitleStyle">
        <item name="android:textAppearance">?attr/oemTextAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/oemColorOnSurface</item>
    </style>
    <style name="BrowseListSubtitleStyle">
        <item name="android:textAppearance">?attr/oemTextAppearanceBodySmall</item>
        <item name="android:textColor">?attr/oemColorOnSurfaceVariant</item>
    </style>
    <style name="BrowseListItemRightArrowStyle">
        <item name="android:src">@null</item>
    </style>
    <style name="MinimizedControlBarTitleStyle">
        <item name="android:textAppearance">?attr/oemTextAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/oemColorOnSurface</item>
    </style>
    <style name="MinimizedControlBarSubtitleStyle">
        <item name="android:textAppearance">?attr/oemTextAppearanceBodySmall</item>
        <item name="android:textColor">?attr/oemColorOnSurfaceVariant</item>
    </style>
    <style name="MinimizedControlBarContentTileStyle" parent="MediaGridIconContainerStyle"/>

    <style name="BrowseSubheaderStyle">
      <item name="android:textAppearance">?attr/oemTextAppearanceHeadlineMedium</item>
      <item name="android:paddingHorizontal">8dp</item>
      <item name="android:paddingVertical">24dp</item>
    </style>

    <style name="ErrorButtonStyle">
        <item name="android:background">@drawable/error_button_background</item>
        <item name="android:textAppearance">?attr/oemTextAppearanceBodyLarge</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:textAlignment">center</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/oemColorOnSurface</item>
    </style>

    <style name="TextAppearance.NoContent">
        <item name="android:textAppearance">?attr/oemTextAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/oemColorOnSurface</item>
    </style>

    <style name="ErrorTextStyle">
        <item name="android:textAppearance">?attr/oemTextAppearanceBodyLarge</item>
    </style>

    <style name="QueueListItemTitlesContainerStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="QueueListItemTitleStyle">
        <item name="android:textAppearance">?attr/oemTextAppearanceBodyLarge</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="QueueListItemSubtitleStyle">
        <item name="android:textAppearance">?attr/oemTextAppearanceBodySmall</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="QueueListItemTimeStyle">
        <item name="android:textAppearance">?attr/oemTextAppearanceBodySmall</item>
        <item name="android:singleLine">true</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MinimizedControlBar">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
</resources>
