<!--
  Overlay resources to configure private displays based on each OEM's preference.
  See also packages/services/Car/service/res/values/config.xml
-->

<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Names of the distant display displays that support Cast -->
    <string-array name="distant_display_names">
        <item>"Center Display"</item>
        <item>"Center Distant Display"</item>
    </string-array>
    <!-- Ids of the distant display displays that support Cast -->
    <string-array name="distant_display_unique_ids">
        <item>"0"</item>
        <item>"virtual:com.android.systemui:DistantDisplay"</item>
    </string-array>
    <!-- Touch capability of the distant display displays that support Cast -->
    <array name="distant_display_touch_supports">
	<item>true</item>
	<item>false</item>
    </array>
    <!-- Display Type: -->
    <!-- 0: Unknown -->
    <!-- 1: Android Logical Display -->
    <!-- 2: Android Automotive Private Display -->
    <integer-array name="distant_display_types">
	<item>1</item>
	<item>2</item>
    </integer-array>
</resources>
