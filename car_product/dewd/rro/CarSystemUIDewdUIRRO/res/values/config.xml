    <string-array name="config_untrimmable_activities" translatable="false">
        <item>@string/widget_component</item>
    </string-array>

    <string-array name="config_default_activities" translatable="false">
        <item>app_grid_panel;com.android.car.portraitlauncher/com.android.car.carlauncher.AppGridActivity</item>
        <item>map_panel;com.android.car.portraitlauncher/.homeactivities.BackgroundPanelBaseActivity</item>
        <item>widget_panel;com.android.car.portraitlauncher/.controlbar.ControlBarActivity</item>
    </string-array>

    <!-- Setup and add safe area and toolbar per display on for Display Compat apps . -->
    <bool name="config_enableSafeAreaAndToolbarPerDisplay">false</bool>

    <!-- Configure which system bars should be displayed. -->
    <bool name="config_enableTopSystemBar">true</bool>
    <!-- TODO(b/446949579): Re-enable flagged resource when R/W flags can be used in RROs -->
    <!--
    <bool name="config_enableTopSystemBar" android:featureFlag="com.android.car.scalableui.enable_ext_panel_updates">false</bool>
    -->
    <bool name="config_enableBottomSystemBar">true</bool>
    <!-- TODO(b/446949579): Re-enable flagged resource when R/W flags can be used in RROs -->
    <!--
    <bool name="config_enableBottomSystemBar" android:featureFlag="com.android.car.scalableui.enable_ext_panel_updates">false</bool>
    -->

    <string name="config_privacyIndicatorLocation">TopCarSystemBar</string>
    <!-- TODO(b/446949579): Re-enable flagged resource when R/W flags can be used in RROs -->
    <!--
    <string name="config_privacyIndicatorLocation" android:featureFlag="com.android.car.scalableui.enable_ext_panel_updates">status</string>
    -->
</resources>